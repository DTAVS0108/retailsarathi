DATABASE_URL="postgresql://retailsarathi:retailsarathi@localhost:5433/retailsarathi"
JWT_SECRET="retail-sarathi-dev-secret-change-in-production"
JWT_EXPIRES_IN="7d"
REDIS_URL="redis://localhost:6379"
PORT=4000
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# --- Production (retailsarathi.in) ---
# NODE_ENV=production
# CORS_ORIGIN="https://retailsarathi.in,https://www.retailsarathi.in"
# PUBLIC_API_ORIGIN=https://api.retailsarathi.in

# Optional: WhatsApp Business / gateway — accepts { to, message, mediaUrl?, filename? }
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=
# PUBLIC_API_ORIGIN=http://localhost:4000

# Optional: live bank statement feed (CSV or JSON array) for Bank reconcile → Sync feed
# BANK_FEED_URL=
# BANK_FEED_TOKEN=

# Account Aggregator — consent redirect (Setu/Finvu). Use {consentId} {tenantId} {callback} placeholders.
# AA_PROVIDER=mock
# AA_PROVIDER_CONSENT_URL=
# AA_FEED_URL=https://example.com/feed/{consentId}.csv

# Daily overdue WhatsApp/SMS reminders at 09:00. Set off to disable.
# REMINDERS_CRON=on
# ARCHIVE_PURGE_CRON=on
# ARCHIVE_RETENTION_DAYS=30
