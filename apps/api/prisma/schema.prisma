generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Multi-tenant core ───────────────────────────────────────────

model Tenant {
  id                String   @id @default(cuid())
  name              String
  /** Short, readable public identifier (e.g. "tyagi-electric-works") — used in customer-facing
   *  URLs like the repair queue display, instead of the internal cuid. */
  slug              String?  @unique
  gstin             String?
  stateCode         String   @default("27")
  compositionScheme Boolean  @default(false)
  phone             String?
  email             String?
  address           String?
  logoUrl           String?
  defaultInvoiceTemplate String @default("classic")
  mobileInvoiceTemplate  String @default("retail-bold")
  invoiceCopyCount       Int      @default(1)
  invoiceDisplayOptions  Json     @default("{}")
  bankName               String?
  bankAccountNo          String?
  bankIfsc               String?
  bankBranch             String?
  /** UPI VPA (e.g. shopname@okhdfcbank) — powers the scan-to-pay QR on the POS checkout screen */
  upiId                  String?
  /** Tax invoice / credit note format — see @retail-sarathi/gst-engine invoice-numbering */
  invoiceNumbering       Json     @default("{}")
  /** Sales journal auto-posting toggles */
  ledgerSettings         Json     @default("{}")
  /** Expected daily check-in time (HH:mm, 24h) used to flag late attendance when no shift is assigned. */
  expectedCheckInTime    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  branches              Branch[]
  users                 User[]
  products              Product[]
  productCategories     ProductCategory[]
  suppliers             Supplier[]
  customers             Customer[]
  invoices              Invoice[]
  repairJobs            RepairJob[]
  devices               Device[]
  repairServiceTypes    RepairServiceType[]
  loanerDevices         LoanerDevice[]
  loanerCheckouts       LoanerCheckout[]
  notificationTemplates NotificationTemplate[]
  accounts              Account[]
  journalEntries        JournalEntry[]
  priceLists            PriceList[]
  scanTemplates         ScanTemplate[]
  syncOutbox            SyncOutbox[]
  syncCursors           SyncCursor[]
  branchStock           BranchStock[]
  branchTransfers       BranchTransfer[]
  auditLogs             AuditLog[]
  hardwareConfigs       HardwareConfig[]
  ecommerceChannels     EcommerceChannel[]
  staffAttendance       StaffAttendance[]
  tradeIns              TradeIn[]
  subscription          TenantSubscription?
  supportTickets        SupportTicket[]
  purchaseOrders        PurchaseOrder[]
  stockTakes            StockTake[]
  aiAgentActions        AiAgentAction[]
  draftStockIns         DraftStockIn[]
  productEnrichments    ProductEnrichment[]
  supplierProductAliases SupplierProductAlias[]
  purchaseBills         PurchaseBill[]
  leaveRequests         LeaveRequest[]
  shifts                Shift[]
  shiftAssignments      ShiftAssignment[]
  payrollRuns           PayrollRun[]
  supplierPayments      SupplierPayment[]
  supplierLedgerEntries SupplierLedgerEntry[]
  customerPayments      CustomerPayment[]
  customerLedgerEntries CustomerLedgerEntry[]
  documentSequences     DocumentSequence[]
  partyReminderLogs     PartyReminderLog[]
  bankStatementLines    BankStatementLine[]
  gstr2bImports         Gstr2bImport[]
  productBatches        ProductBatch[]
  subscriptionStatus    SubscriptionStatus @default(TRIAL)
  subscriptionInvoices  SubscriptionInvoice[]
  /** Platform-admin kill switch — blocks tenant JWT validation and API access when true. */
  isSuspended           Boolean   @default(false)
  suspendedAt           DateTime?
  suspendedReason       String?
}

/// Atomic invoice / credit-note counters per FY or period.
model DocumentSequence {
  id        String   @id @default(cuid())
  tenantId  String
  docType   String
  periodKey String
  lastSeq   Int      @default(0)
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, docType, periodKey])
  @@index([tenantId])
}

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  address   String
  stateCode String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  managerId String?

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  manager    User?       @relation("BranchManager", fields: [managerId], references: [id], onDelete: SetNull)
  users      User[]
  invoices   Invoice[]
  repairJobs RepairJob[]
  branchStock BranchStock[]
  transfersFrom BranchTransfer[] @relation("TransferFrom")
  transfersTo   BranchTransfer[] @relation("TransferTo")
  hardwareConfigs HardwareConfig[]
  staffAttendance StaffAttendance[]
  purchaseOrders PurchaseOrder[]
  stockTakes     StockTake[]
  loanerDevices   LoanerDevice[]

  @@index([tenantId])
}

enum UserRole {
  OWNER
  MANAGER
  CASHIER
  TECHNICIAN
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  branchId     String?
  email        String
  passwordHash String
  name         String
  role         UserRole @default(CASHIER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  phone                 String?
  address               String?
  dateOfJoining         DateTime?
  monthlySalary         Decimal?  @db.Decimal(12, 2)
  /** Per-user commission rate override — falls back to a role default in code when unset. */
  commissionPct         Decimal?  @db.Decimal(5, 2)
  photoUrl              String?
  emergencyContactName  String?
  emergencyContactPhone String?

  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch?     @relation(fields: [branchId], references: [id])
  managedBranches Branch[] @relation("BranchManager")
  repairJobs   RepairJob[] @relation("TechnicianJobs")
  attendance   StaffAttendance[]
  commissions  StaffCommission[]
  leaveRequests LeaveRequest[] @relation("LeaveRequester")
  leaveDecisions LeaveRequest[] @relation("LeaveApprover")
  shiftAssignments ShiftAssignment[]
  payslips     Payslip[]
  purchaseBillsCreated PurchaseBill[] @relation("PurchaseBillCreatedBy")
  customersCreated     Customer[]     @relation("CustomerCreatedBy")
  customersUpdated     Customer[]     @relation("CustomerUpdatedBy")
  partyRemindersCreated PartyReminderLog[] @relation("PartyReminderCreatedBy")

  @@unique([tenantId, email])
  @@index([tenantId])
}

// ─── Inventory ───────────────────────────────────────────────────

model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  phone     String?
  email     String?
  gstin     String?
  address   String?
  addressLine2 String?
  city         String?
  pincode      String?
  country      String?  @default("IN")
  stateCode    String?
  /// Payment details from supplier invoices (NEFT/RTGS).
  bankName     String?
  bankAccount  String?
  ifsc         String?
  bankBranch   String?
  /// Cached payable balance (positive = we owe supplier).
  outstandingBalance Decimal @db.Decimal(14, 2) @default(0)
  /// Unallocated advances (paid but not yet applied to bills).
  advanceBalance     Decimal @db.Decimal(14, 2) @default(0)
  /// Soft-archive mistaken / unused suppliers (keeps khata history).
  isActive  Boolean  @default(true)
  /// Set when soft-archived. Used for 30-day auto-purge from Corrections.
  archivedAt DateTime?
  /// Hidden from archived restore list when history blocks hard-delete.
  purgedAt   DateTime?
  /// MSME registered supplier — India 45-day payment discipline.
  isMsme    Boolean  @default(false)
  /// Default credit days for new purchase bills from this supplier.
  paymentTermsDays Int @default(30)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  purchaseBills  PurchaseBill[]
  payments       SupplierPayment[]
  ledgerEntries  SupplierLedgerEntry[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, isActive, archivedAt])
  @@index([tenantId, isMsme])
}

enum PurchaseBillStatus {
  DRAFT
  POSTED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

/// One supplier purchase invoice that can cover many stocked products.
model PurchaseBill {
  id              String             @id @default(cuid())
  tenantId        String
  supplierId      String?
  supplierName    String?
  invoiceNumber   String
  invoiceDate     DateTime?
  /// Payment due date for AP aging (defaults to invoiceDate + paymentTermsDays).
  dueDate         DateTime?
  /// Credit days used when dueDate was derived (common Indian distributor terms: 7/15/30/45).
  paymentTermsDays Int               @default(30)
  gstin           String?
  placeOfSupply   String?
  irn             String?
  uploadId        String?
  billImagePath   String?
  billImageName   String?
  billImageMime   String?
  subtotal        Decimal            @db.Decimal(14, 2) @default(0)
  taxAmount       Decimal            @db.Decimal(14, 2) @default(0)
  cgstAmount      Decimal            @db.Decimal(14, 2) @default(0)
  sgstAmount      Decimal            @db.Decimal(14, 2) @default(0)
  igstAmount      Decimal            @db.Decimal(14, 2) @default(0)
  totalAmount     Decimal            @db.Decimal(14, 2) @default(0)
  paidAmount      Decimal            @db.Decimal(14, 2) @default(0)
  status          PurchaseBillStatus @default(POSTED)
  notes           String?
  createdByUserId String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier    Supplier?                    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy   User?                        @relation("PurchaseBillCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lines       PurchaseBillLine[]
  allocations SupplierPaymentAllocation[]
  ledgerEntries SupplierLedgerEntry[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, supplierId])
  @@index([tenantId, status])
  @@index([tenantId, createdByUserId])
  @@index([tenantId, invoiceDate])
  @@index([tenantId, dueDate])
}

model PurchaseBillLine {
  id          String  @id @default(cuid())
  billId      String
  productId   String?
  productName String
  sku         String?
  quantity    Decimal @db.Decimal(12, 3)
  unitCost    Decimal @db.Decimal(12, 2) @default(0)
  lineTotal   Decimal @db.Decimal(14, 2) @default(0)
  hsnCode     String?
  gstRate     Decimal? @db.Decimal(5, 2)

  bill    PurchaseBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  product Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([billId])
  @@index([productId])
}

enum SupplierLedgerType {
  BILL
  PAYMENT
  ADJUSTMENT
  ADVANCE
  DEBIT_NOTE
  CREDIT_NOTE
  PAYMENT_REVERSAL
}

model SupplierLedgerEntry {
  id           String             @id @default(cuid())
  tenantId     String
  supplierId   String
  type         SupplierLedgerType
  /// Always positive; BILL increases payable, PAYMENT decreases.
  amount       Decimal            @db.Decimal(14, 2)
  balanceAfter Decimal            @db.Decimal(14, 2)
  billId       String?
  paymentId    String?
  notes        String?
  entryDate    DateTime           @default(now())
  createdAt    DateTime           @default(now())

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  bill     PurchaseBill?    @relation(fields: [billId], references: [id], onDelete: SetNull)
  payment  SupplierPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([tenantId, supplierId, entryDate])
}

enum SupplierPaymentMethod {
  CASH
  UPI
  NEFT
  RTGS
  CHEQUE
  BANK_TRANSFER
  OTHER
}

enum SupplierPaymentStatus {
  POSTED
  VOIDED
  BOUNCED
}

model SupplierPayment {
  id               String                 @id @default(cuid())
  tenantId         String
  supplierId       String
  amount           Decimal                @db.Decimal(14, 2)
  /// TDS deducted at source — dues cleared = amount + tdsAmount; cash out = amount.
  tdsAmount        Decimal                @db.Decimal(14, 2) @default(0)
  /// Portion of amount not allocated to bills (went to advance).
  advanceAmount    Decimal                @db.Decimal(14, 2) @default(0)
  method           SupplierPaymentMethod  @default(CASH)
  status           SupplierPaymentStatus  @default(POSTED)
  paymentDate      DateTime               @default(now())
  referenceNo      String?
  bankName         String?
  notes            String?
  attachmentPath   String?
  attachmentName   String?
  attachmentMime   String?
  voidedAt         DateTime?
  voidReason       String?
  bouncedAt        DateTime?
  bounceReason     String?
  createdAt        DateTime               @default(now())

  tenant      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier    Supplier                     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  allocations SupplierPaymentAllocation[]
  ledgerEntries SupplierLedgerEntry[]
  bankMatches BankStatementLine[]

  @@index([tenantId, supplierId, paymentDate])
  @@index([tenantId, status])
}

model SupplierPaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String
  billId    String
  amount    Decimal @db.Decimal(14, 2)

  payment SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bill    PurchaseBill    @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([billId])
}

enum PartyType {
  SUPPLIER
  CUSTOMER
}

enum ReminderChannel {
  WHATSAPP
  SMS
  CALL_NOTE
}

enum ReminderStatus {
  SENT
  FAILED
}

/// Staff-sent dues reminders (wa.me / SMS) — audit trail, not a messaging gateway.
model PartyReminderLog {
  id                  String          @id @default(cuid())
  tenantId            String
  partyType           PartyType
  partyId             String
  channel             ReminderChannel @default(WHATSAPP)
  templateKey         String          @default("DUES_SUMMARY")
  body                String
  outstandingSnapshot Decimal         @db.Decimal(14, 2) @default(0)
  billCount           Int?
  status              ReminderStatus  @default(SENT)
  createdByUserId     String?
  createdAt           DateTime        @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("PartyReminderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, partyType, partyId, createdAt])
  @@index([tenantId, createdAt])
}

enum BankStatementLineStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

/// Imported bank/UPI statement rows for matching to supplier/customer payments.
model BankStatementLine {
  id                       String                  @id @default(cuid())
  tenantId                 String
  importBatchId            String?
  txnDate                  DateTime
  description              String                  @default("")
  amount                   Decimal                 @db.Decimal(14, 2)
  utr                      String?
  chequeNo                 String?
  rawJson                  Json?
  status                   BankStatementLineStatus @default(UNMATCHED)
  matchedSupplierPaymentId String?
  matchedCustomerPaymentId String?
  matchedAt                DateTime?
  createdAt                DateTime                @default(now())

  tenant                 Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matchedSupplierPayment SupplierPayment? @relation(fields: [matchedSupplierPaymentId], references: [id], onDelete: SetNull)
  matchedCustomerPayment CustomerPayment? @relation(fields: [matchedCustomerPaymentId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, txnDate])
  @@index([tenantId, utr])
  @@index([matchedSupplierPaymentId])
  @@index([matchedCustomerPaymentId])
}

enum ProductCondition {
  NEW
  REFURB
  OPEN_BOX
}

enum SerialStatus {
  IN_STOCK
  SOLD
  IN_REPAIR
}

model Product {
  id                String   @id @default(cuid())
  tenantId          String
  sku               String
  barcode           String?
  name              String
  hsnCode           String
  category          String?
  brand             String?
  model             String?
  unit              String   @default("pcs")
  salePrice         Decimal  @db.Decimal(12, 2)
  purchasePrice     Decimal  @db.Decimal(12, 2) @default(0)
  gstRate           Decimal  @db.Decimal(5, 2)
  stockQty          Decimal  @db.Decimal(12, 3) @default(0)
  lowStockThreshold Decimal  @db.Decimal(12, 3) @default(5)
  trackSerial       Boolean  @default(false)
  /// Lot / batch + expiry (FMCG / pharma). Prefer over serial for consumables.
  trackBatch        Boolean  @default(false)
  /// Parent SKU for size/colour variants (self-relation via parentProductId).
  parentProductId   String?
  /// Display label e.g. "Red / L" or "500ml".
  variantLabel      String?
  /// Cached ABC grade from last analytics refresh (A|B|C).
  abcGrade          String?
  lastCountedAt     DateTime?
  needsEnrichment   Boolean  @default(false)
  isActive          Boolean  @default(true)
  /// Set when soft-archived (isActive=false). Used for 30-day auto-purge.
  archivedAt        DateTime?
  /// Hidden from Corrections restore list when hard-delete is blocked by history FKs.
  purgedAt          DateTime?
  /// Primary product photo (URL under /uploads/products/…)
  imageUrl          String?
  /// Extra files: [{ url, name, mimeType, size }]
  attachments       Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentProduct  Product?          @relation("ProductVariants", fields: [parentProductId], references: [id], onDelete: SetNull)
  variants       Product[]         @relation("ProductVariants")
  serials        ProductSerial[]
  batches        ProductBatch[]
  stockLedger    StockLedger[]
  invoiceLines   InvoiceLine[]
  priceListItems PriceListItem[]
  repairParts    RepairPartUsed[]
  branchStock    BranchStock[]
  transferItems  BranchTransferItem[]
  poLines        PurchaseOrderLine[]
  stockTakeLines StockTakeLine[]
  enrichments    ProductEnrichment[]
  supplierAliases SupplierProductAlias[]
  purchaseBillLines PurchaseBillLine[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, barcode])
  @@index([tenantId, needsEnrichment])
  @@index([tenantId, abcGrade])
  @@index([tenantId, isActive, archivedAt])
  @@index([parentProductId])
}

/// Batch / lot stock for trackBatch products (FEFO at POS).
model ProductBatch {
  id          String    @id @default(cuid())
  tenantId    String
  productId   String
  batchNumber String
  expiryDate  DateTime?
  quantity    Decimal   @db.Decimal(12, 3) @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockLedgerEntries StockLedger[]

  @@unique([productId, batchNumber])
  @@index([tenantId, productId])
  @@index([tenantId, expiryDate])
}

/// Tenant product category master — keeps spelling consistent for stock boards.
model ProductCategory {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ProductSerial {
  id           String           @id @default(cuid())
  productId    String
  serialNumber String
  imei         String?
  condition    ProductCondition @default(NEW)
  warrantyEnd  DateTime?
  status       SerialStatus     @default(IN_STOCK)
  createdAt    DateTime         @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, serialNumber])
  @@index([imei])
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  REPAIR_USE
  TRANSFER
}

model StockLedger {
  id          String            @id @default(cuid())
  tenantId    String
  productId   String
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12, 3)
  referenceId String?
  notes       String?
  createdAt   DateTime          @default(now())
  /** Which batch this movement touched — set only for trackBatch products; a single sale line
      spanning multiple batches (FEFO) becomes multiple ledger rows, one per batch. */
  batchId       String?
  /** Which invoice line caused this movement — lets a partial return/cancel look up exactly which
      batches (and how much of each) to reverse for that specific line. */
  invoiceLineId String?

  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch       ProductBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  invoiceLine InvoiceLine?  @relation(fields: [invoiceLineId], references: [id], onDelete: SetNull)

  @@index([tenantId, productId])
  @@index([batchId])
  @@index([invoiceLineId])
}

// ─── Customers & CRM ─────────────────────────────────────────────

enum CustomerSegment {
  RETAIL
  DEALER
  DISTRIBUTOR
  CORPORATE
}

model Customer {
  id                  String          @id @default(cuid())
  tenantId            String
  name                String
  phone               String
  email               String?
  gstin               String?
  address             String?
  addressLine2        String?
  city                String?
  pincode             String?
  country             String            @default("IN")
  stateCode           String?
  segment             CustomerSegment @default(RETAIL)
  creditLimit         Decimal         @db.Decimal(12, 2) @default(0)
  outstandingBalance  Decimal         @db.Decimal(12, 2) @default(0)
  /// Unallocated customer advances (over-collection).
  advanceBalance      Decimal         @db.Decimal(12, 2) @default(0)
  loyaltyPoints       Int             @default(0)
  tags                String[]        @default([])
  whatsappOptIn       Boolean         @default(false)
  createdByUserId     String?
  updatedByUserId     String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy  User?       @relation("CustomerCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy  User?       @relation("CustomerUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  invoices   Invoice[]
  repairJobs RepairJob[]
  devices    Device[]
  loanerCheckouts LoanerCheckout[]
  loyaltyTransactions LoyaltyTransaction[]
  payments       CustomerPayment[]
  ledgerEntries  CustomerLedgerEntry[]

  @@index([tenantId])
  @@index([tenantId, phone])
  @@index([tenantId, createdByUserId])
  @@index([tenantId, updatedByUserId])
}

enum LoanerDeviceStatus {
  AVAILABLE
  ON_LOAN
  IN_REPAIR
  RETIRED
}

enum LoanerDeviceCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
}

/**
 * A shop-owned device lent to a customer while their own device is being repaired. Deliberately
 * not modeled on Product/ProductSerial — loaners aren't sold, priced, or GST-relevant, so this
 * stays a simple pool with no StockLedger-style movement log (status + timestamps is enough
 * audit trail for a non-sale asset).
 */
model LoanerDevice {
  id         String                @id @default(cuid())
  tenantId   String
  branchId   String?
  brand      String?
  model      String
  identifier String?
  condition  LoanerDeviceCondition @default(GOOD)
  status     LoanerDeviceStatus    @default(AVAILABLE)
  notes      String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch?          @relation(fields: [branchId], references: [id])
  loans  LoanerCheckout[]

  @@index([tenantId, status])
}

model LoanerCheckout {
  id               String                 @id @default(cuid())
  tenantId         String
  loanerDeviceId   String
  repairJobId      String
  customerId       String
  checkedOutAt     DateTime               @default(now())
  expectedReturnAt DateTime?
  returnedAt       DateTime?
  conditionOut     LoanerDeviceCondition?
  conditionIn      LoanerDeviceCondition?
  notes            String?

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loanerDevice LoanerDevice @relation(fields: [loanerDeviceId], references: [id])
  repairJob    RepairJob    @relation(fields: [repairJobId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])

  @@index([tenantId, loanerDeviceId])
  @@index([tenantId, repairJobId])
}

/** A common repair service offered by the shop, for quick estimate prefill at intake. */
model RepairServiceType {
  id                    String   @id @default(cuid())
  tenantId              String
  name                  String
  defaultPrice          Decimal? @db.Decimal(12, 2)
  typicalTurnaroundDays Int?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  repairJobs RepairJob[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

/** A customer's device, tracked across multiple repair visits over time. */
model Device {
  id           String   @id @default(cuid())
  tenantId     String
  customerId   String
  brand        String?
  model        String
  imei         String?
  serialNumber String?
  notes        String?
  createdAt    DateTime @default(now())

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  repairJobs RepairJob[]

  @@index([tenantId, customerId])
  @@index([tenantId, imei])
}

enum CustomerLedgerType {
  INVOICE
  COLLECTION
  CREDIT_NOTE
  ADJUSTMENT
}

enum CustomerPaymentMethod {
  CASH
  UPI
  CARD
  CHEQUE
  BANK_TRANSFER
  OTHER
}

enum CustomerPaymentStatus {
  POSTED
  VOIDED
  BOUNCED
}

/// Customer udhaar khata — INVOICE increases receivable, COLLECTION decreases.
model CustomerLedgerEntry {
  id           String             @id @default(cuid())
  tenantId     String
  customerId   String
  type         CustomerLedgerType
  /// Always positive; sign implied by type.
  amount       Decimal            @db.Decimal(14, 2)
  balanceAfter Decimal            @db.Decimal(14, 2)
  invoiceId    String?
  paymentId    String?
  notes        String?
  entryDate    DateTime           @default(now())
  createdAt    DateTime           @default(now())

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice  Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payment  CustomerPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([tenantId, customerId, entryDate])
}

model CustomerPayment {
  id               String                 @id @default(cuid())
  tenantId         String
  customerId       String
  amount           Decimal                @db.Decimal(14, 2)
  method           CustomerPaymentMethod  @default(CASH)
  status           CustomerPaymentStatus  @default(POSTED)
  paymentDate      DateTime               @default(now())
  referenceNo      String?
  bankName         String?
  notes            String?
  attachmentPath   String?
  attachmentName   String?
  attachmentMime   String?
  voidedAt         DateTime?
  voidReason       String?
  bouncedAt        DateTime?
  bounceReason     String?
  createdAt        DateTime               @default(now())

  tenant      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer                     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  allocations CustomerPaymentAllocation[]
  ledgerEntries CustomerLedgerEntry[]
  bankMatches BankStatementLine[]

  @@index([tenantId, customerId, paymentDate])
  @@index([tenantId, status])
}

model CustomerPaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String
  invoiceId String
  amount    Decimal @db.Decimal(14, 2)

  payment CustomerPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([invoiceId])
}

// ─── Wholesale pricing ─────────────────────────────────────────────

enum PriceListType {
  RETAIL
  DEALER
  DISTRIBUTOR
  WHOLESALE
}

model PriceList {
  id        String        @id @default(cuid())
  tenantId  String
  name      String
  type      PriceListType
  isDefault Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  PriceListItem[]

  @@index([tenantId])
  @@index([tenantId, type])
}

model PriceListItem {
  id          String  @id @default(cuid())
  priceListId String
  productId   String
  price       Decimal @db.Decimal(12, 2)
  minQty      Decimal @db.Decimal(12, 3) @default(1)

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// One price per product per min-qty break (supports tiered wholesale pricing).
  @@unique([priceListId, productId, minQty])
  @@index([priceListId, productId])
}

// ─── Billing ─────────────────────────────────────────────────────

enum InvoiceType {
  TAX_INVOICE
  BILL_OF_SUPPLY
  DELIVERY_CHALLAN
  CREDIT_NOTE
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
  CANCELLED
}

enum SupplyType {
  INTRA_STATE
  INTER_STATE
}

model Invoice {
  id                String        @id @default(cuid())
  tenantId          String
  branchId          String
  customerId        String?
  invoiceNumber     String
  type              InvoiceType   @default(TAX_INVOICE)
  status            InvoiceStatus @default(DRAFT)
  supplyType        SupplyType    @default(INTRA_STATE)
  subtotal          Decimal       @db.Decimal(12, 2)
  totalDiscount     Decimal       @db.Decimal(12, 2) @default(0)
  totalCgst         Decimal       @db.Decimal(12, 2) @default(0)
  totalSgst         Decimal       @db.Decimal(12, 2) @default(0)
  totalIgst         Decimal       @db.Decimal(12, 2) @default(0)
  grandTotal        Decimal       @db.Decimal(12, 2)
  notes             String?
  isWholesale       Boolean       @default(false)
  irn               String?
  einvoiceQr        String?
  ewayBillNo        String?
  vehicleNo         String?
  soldByUserId      String?
  originalInvoiceId String?
  /** Restocking / handling fee retained on return (credit note only). */
  processingFee     Decimal       @db.Decimal(12, 2) @default(0)
  /** Client-supplied key for retry-safe creation (Desktop/Mobile offline+online paths) — a
      repeated create with the same key returns the original invoice instead of duplicating it. */
  idempotencyKey    String?       @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch        @relation(fields: [branchId], references: [id])
  customer        Customer?     @relation(fields: [customerId], references: [id])
  originalInvoice Invoice?      @relation("CreditNotes", fields: [originalInvoiceId], references: [id])
  creditNotes     Invoice[]     @relation("CreditNotes")
  lines           InvoiceLine[]
  payments        Payment[]
  customerLedgerEntries CustomerLedgerEntry[]
  customerPaymentAllocations CustomerPaymentAllocation[]
  repairJob       RepairJob?

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, createdAt])
  @@index([originalInvoiceId])
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  productId      String?
  productName    String
  /** Snapshot at bill time — survives catalog archive/purge. */
  productSku     String?
  /** Snapshot at bill time — survives catalog archive/purge. */
  productBarcode String?
  hsnCode        String
  unit           String  @default("pcs")
  quantity       Decimal @db.Decimal(12, 3)
  unitPrice      Decimal @db.Decimal(12, 2)
  discount       Decimal @db.Decimal(12, 2) @default(0)
  gstRate        Decimal @db.Decimal(5, 2)
  cgst           Decimal @db.Decimal(12, 2) @default(0)
  sgst           Decimal @db.Decimal(12, 2) @default(0)
  igst           Decimal @db.Decimal(12, 2) @default(0)
  taxableAmount  Decimal @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)
  serialNumbers  String[] @default([])
  /** Links credit-note line back to original tax invoice line. */
  sourceInvoiceLineId String?
  /** Product.purchasePrice at the moment this line was created — lets margin reports use
      price-at-time-of-sale instead of drifting with later purchase-price changes. Nullable:
      legacy rows predating this field have no snapshot. */
  costPriceSnapshot Decimal? @db.Decimal(12, 2)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  stockLedgerEntries StockLedger[]

  @@index([invoiceId])
  @@index([productId])
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  CREDIT
  BANK_TRANSFER
  EMI
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  reference String?
  createdAt DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ─── Repair ──────────────────────────────────────────────────────

enum RepairStatus {
  RECEIVED
  DIAGNOSED
  AWAITING_CUSTOMER_APPROVAL
  AWAITING_PARTS
  IN_REPAIR
  ON_HOLD
  READY
  DELIVERED
  CANCELLED
}

model RepairJob {
  id              String       @id @default(cuid())
  tenantId        String
  branchId        String
  customerId      String
  technicianId    String?
  deviceId        String?
  serviceTypeId   String?
  jobNumber       String
  deviceModel     String
  imei            String?
  issue           String
  accessories     String?
  status          RepairStatus @default(RECEIVED)
  estimateAmount  Decimal?     @db.Decimal(12, 2)
  finalAmount     Decimal?     @db.Decimal(12, 2)
  /** Deposit collected at intake (e.g. for parts) — deducted from the final invoice's payment total. */
  advancePaid     Decimal?     @db.Decimal(12, 2)
  warrantyDays    Int          @default(30)
  customerApproved Boolean?
  receivedAt      DateTime     @default(now())
  deliveredAt     DateTime?
  warrantyEndsAt  DateTime?
  photoUrls       String[]     @default([])
  linkedInvoiceId String?      @unique
  /** Structured pre-existing-damage capture at intake (screen condition, powers-on, missing parts, etc). */
  intakeChecklist Json?
  /** Set when this job is a warranty comeback for a prior DELIVERED job on the same device. */
  reopenedFromId  String?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch                @relation(fields: [branchId], references: [id])
  customer     Customer              @relation(fields: [customerId], references: [id])
  technician   User?                 @relation("TechnicianJobs", fields: [technicianId], references: [id])
  device        Device?              @relation(fields: [deviceId], references: [id])
  serviceType   RepairServiceType?   @relation(fields: [serviceTypeId], references: [id])
  linkedInvoice Invoice?             @relation(fields: [linkedInvoiceId], references: [id], onDelete: SetNull)
  reopenedFrom  RepairJob?           @relation("RepairReopen", fields: [reopenedFromId], references: [id])
  reopenedBy    RepairJob[]          @relation("RepairReopen")
  statusHistory RepairStatusHistory[]
  partsUsed    RepairPartUsed[]
  loanerCheckouts LoanerCheckout[]

  @@unique([tenantId, jobNumber])
  @@index([tenantId, status])
  @@index([tenantId, deviceId])
}

model RepairStatusHistory {
  id          String       @id @default(cuid())
  repairJobId String
  status      RepairStatus
  notes       String?
  createdAt   DateTime     @default(now())

  repairJob RepairJob @relation(fields: [repairJobId], references: [id], onDelete: Cascade)

  @@index([repairJobId])
}

model RepairPartUsed {
  id          String  @id @default(cuid())
  repairJobId String
  productId   String
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(12, 2)

  repairJob RepairJob @relation(fields: [repairJobId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@index([repairJobId])
}

// ─── Notifications ─────────────────────────────────────────────────

enum NotificationChannel {
  WHATSAPP
  SMS
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model NotificationTemplate {
  id        String              @id @default(cuid())
  tenantId  String
  name      String
  channel   NotificationChannel
  body      String
  variables String[]            @default([])
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logs   NotificationLog[]

  @@index([tenantId])
}

model NotificationLog {
  id         String             @id @default(cuid())
  templateId String?
  tenantId   String
  channel    NotificationChannel
  recipient  String
  body       String
  status     NotificationStatus @default(PENDING)
  error      String?
  sentAt     DateTime?
  deliveredAt DateTime?
  providerMessageId String?
  createdAt  DateTime           @default(now())

  template NotificationTemplate? @relation(fields: [templateId], references: [id])

  @@index([tenantId, status])
}

// ─── Accounting ────────────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model Account {
  id       String      @id @default(cuid())
  tenantId String
  code     String
  name     String
  type     AccountType

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  debitEntries  JournalEntry[] @relation("DebitAccount")
  creditEntries JournalEntry[] @relation("CreditAccount")

  @@unique([tenantId, code])
  @@index([tenantId])
}

model JournalEntry {
  id              String   @id @default(cuid())
  tenantId        String
  date            DateTime
  description     String
  debitAccountId  String
  creditAccountId String
  amount          Decimal  @db.Decimal(12, 2)
  referenceType   String?
  referenceId     String?
  createdAt       DateTime @default(now())

  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  debitAccount  Account @relation("DebitAccount", fields: [debitAccountId], references: [id])
  creditAccount Account @relation("CreditAccount", fields: [creditAccountId], references: [id])

  @@index([tenantId, date])
}

model FinancialPeriod {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  startDate DateTime
  endDate   DateTime
  isClosed  Boolean  @default(false)

  @@index([tenantId])
}

// ─── Scan templates (Phase 2) ─────────────────────────────────────

model ScanTemplate {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  supplierName  String?
  fieldMappings Json     @default("{}")
  sampleText    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model InvoiceUpload {
  id            String   @id @default(cuid())
  tenantId      String
  originalName  String
  storedName    String
  filePath      String
  mimeType      String?
  size          Int
  extractedText String?
  extractedData Json?
  kept          Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
}

enum DraftStockInStatus {
  OPEN
  PARTIAL
  CONFIRMED
  DISCARDED
}

enum EnrichmentStatus {
  PENDING
  DONE
  SKIPPED
}

/// Soft-commit / review session for supplier invoice stock-in (Phase 3).
model DraftStockIn {
  id            String             @id @default(cuid())
  tenantId      String
  uploadId      String?
  supplierName  String?
  invoiceNumber String?
  invoiceDate   String?
  gstin         String?
  status        DraftStockInStatus @default(OPEN)
  previewJson   Json               @default("{}")
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

/// Queue for products missing barcode / sale price / model after stock-in (Phase 2).
model ProductEnrichment {
  id             String           @id @default(cuid())
  tenantId       String
  productId      String
  sourceUploadId String?
  draftId        String?
  status         EnrichmentStatus @default(PENDING)
  missingFields  String[]         @default([])
  draftName      String?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([productId])
}

/// Maps supplier invoice line names → catalog products (Phase 4).
model SupplierProductAlias {
  id           String   @id @default(cuid())
  tenantId     String
  supplierId   String?
  supplierName String?
  aliasName    String
  aliasKey     String
  productId    String
  hsnCode      String?
  hitCount     Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, aliasKey])
  @@index([tenantId, supplierName])
  @@index([productId])
}

model LoyaltyTransaction {
  id          String   @id @default(cuid())
  tenantId    String
  customerId  String
  points      Int
  reason      String
  referenceId String?
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
}

// ─── Sync (offline-first) ──────────────────────────────────────────

enum SyncOperation {
  CREATE
  UPDATE
  DELETE
}

enum SyncStatus {
  PENDING
  SYNCED
  CONFLICT
  FAILED
}

model SyncOutbox {
  id         String        @id @default(cuid())
  tenantId   String
  deviceId   String
  entityType String
  entityId   String
  operation  SyncOperation
  payload    Json
  status     SyncStatus    @default(PENDING)
  error      String?
  createdAt  DateTime      @default(now())
  syncedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, deviceId, status])
}

model SyncCursor {
  id           String   @id @default(cuid())
  tenantId     String
  deviceId     String
  entityType   String
  lastSyncedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, deviceId, entityType])
}

// ─── Phase 5: Multi-branch stock ───────────────────────────────────

model BranchStock {
  id        String  @id @default(cuid())
  tenantId  String
  branchId  String
  productId String
  quantity  Decimal @db.Decimal(12, 3) @default(0)
  /** Per-branch low-stock threshold; falls back to the product's global lowStockThreshold when unset. */
  reorderLevel Decimal? @db.Decimal(12, 3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([tenantId])
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model BranchTransfer {
  id           String         @id @default(cuid())
  tenantId     String
  fromBranchId String
  toBranchId   String
  status       TransferStatus @default(PENDING)
  notes        String?
  createdAt    DateTime       @default(now())
  completedAt  DateTime?

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromBranch Branch               @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranch   Branch               @relation("TransferTo", fields: [toBranchId], references: [id])
  items      BranchTransferItem[]

  @@index([tenantId, status])
}

model BranchTransferItem {
  id         String  @id @default(cuid())
  transferId String
  productId  String
  quantity   Decimal @db.Decimal(12, 3)

  transfer BranchTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product        @relation(fields: [productId], references: [id])

  @@index([transferId])
}

// ─── Phase 5: Analytics / Compliance audit ─────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType])
}

// ─── Phase 5: Hardware ─────────────────────────────────────────────

enum HardwareDeviceType {
  THERMAL_PRINTER
  BARCODE_SCANNER
  CASH_DRAWER
  WEIGHING_SCALE
  CUSTOMER_DISPLAY
  LABEL_PRINTER
}

model HardwareConfig {
  id         String             @id @default(cuid())
  tenantId   String
  branchId   String?
  deviceType HardwareDeviceType
  name       String
  settings   Json               @default("{}")
  isActive   Boolean            @default(true)
  createdAt  DateTime           @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([tenantId])
}

// ─── Phase 5: E-commerce sync ──────────────────────────────────────

enum EcommercePlatform {
  SHOPIFY
  WOOCOMMERCE
  AMAZON
  FLIPKART
  MEESHO
  MYNTRA
  AJIO
  SNAPDEAL
  JIOMART
  NYKAA
  PAYTM_MALL
  INDIA_MART
  ETSY
  EBAY
  MAGENTO
  OPENCART
  CUSTOM
}

enum EcommerceOrderStatus {
  IMPORTED
  FULFILLED
  CANCELLED
  FAILED
}

model EcommerceChannel {
  id           String            @id @default(cuid())
  tenantId     String
  platform     EcommercePlatform
  name         String
  credentials  Json              @default("{}")
  isActive     Boolean           @default(true)
  lastSyncAt   DateTime?
  createdAt    DateTime          @default(now())
  /** Bearer token for the inbound webhook receiver (CUSTOM platform only) — external systems
      POST real orders here instead of relying on a fabricated demo sync. */
  webhookToken String?           @unique

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders EcommerceOrder[]

  @@index([tenantId])
}

model EcommerceOrder {
  id          String               @id @default(cuid())
  channelId   String
  externalId  String
  status      EcommerceOrderStatus @default(IMPORTED)
  customerName String?
  totalAmount Decimal              @db.Decimal(12, 2) @default(0)
  payload     Json
  invoiceId   String?
  createdAt   DateTime             @default(now())

  channel EcommerceChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, externalId])
  @@index([channelId, status])
}

// ─── Phase 5: Staff ────────────────────────────────────────────────

model StaffAttendance {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  branchId  String
  checkIn   DateTime
  checkOut  DateTime?
  isLate    Boolean   @default(false)
  notes     String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id])

  @@index([tenantId, userId])
}

model StaffCommission {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String
  periodStart   DateTime
  periodEnd     DateTime
  salesTotal    Decimal  @db.Decimal(12, 2) @default(0)
  repairTotal   Decimal  @db.Decimal(12, 2) @default(0)
  commissionPct Decimal  @db.Decimal(5, 2) @default(2)
  commissionAmt Decimal  @db.Decimal(12, 2) @default(0)
  invoiceIds    String[] @default([])
  repairJobIds  String[] @default([])
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
}

// ─── People & Ops: Leave, Shifts, Payroll ───────────────────────────

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id           String      @id @default(cuid())
  tenantId     String
  userId       String
  leaveType    String
  fromDate     DateTime
  toDate       DateTime
  reason       String?
  status       LeaveStatus @default(PENDING)
  approvedById String?
  decidedAt    DateTime?
  createdAt    DateTime    @default(now())

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User   @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User?  @relation("LeaveApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([tenantId, userId])
}

model Shift {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String?
  name      String
  startTime String
  endTime   String
  createdAt DateTime @default(now())

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments ShiftAssignment[]

  @@index([tenantId])
}

model ShiftAssignment {
  id       String   @id @default(cuid())
  tenantId String
  userId   String
  shiftId  String
  date     DateTime

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  shift  Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([tenantId])
}

enum PayrollStatus {
  DRAFT
  FINALIZED
}

model PayrollRun {
  id          String        @id @default(cuid())
  tenantId    String
  periodStart DateTime
  periodEnd   DateTime
  status      PayrollStatus @default(DRAFT)
  createdAt   DateTime      @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payslips Payslip[]

  @@index([tenantId, status])
}

model Payslip {
  id                   String    @id @default(cuid())
  payrollRunId         String
  userId               String
  baseSalary           Decimal   @db.Decimal(12, 2) @default(0)
  commissionAmt        Decimal   @db.Decimal(12, 2) @default(0)
  unpaidLeaveDeduction Decimal   @db.Decimal(12, 2) @default(0)
  netPay               Decimal   @db.Decimal(12, 2) @default(0)
  paidAt               DateTime?

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([payrollRunId, userId])
  @@index([payrollRunId])
}

// ─── Phase 5: Trade-in ─────────────────────────────────────────────

enum TradeInStatus {
  QUOTED
  ACCEPTED
  RECEIVED
  REFURBISHED
  SOLD
  REJECTED
}

model TradeIn {
  id              String        @id @default(cuid())
  tenantId        String
  customerId      String?
  deviceModel     String
  imei            String?
  condition       ProductCondition @default(REFURB)
  quotedValue     Decimal       @db.Decimal(12, 2)
  finalValue      Decimal?      @db.Decimal(12, 2)
  status          TradeInStatus @default(QUOTED)
  notes           String?
  refurbProductId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

// ─── Phase 5: Subscriptions ────────────────────────────────────────

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

model SubscriptionPlan {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  priceMonthly Decimal  @db.Decimal(10, 2)
  maxUsers     Int      @default(3)
  maxProducts  Int      @default(500)
  maxBranches  Int      @default(1)
  features     String[] @default([])
  isActive     Boolean  @default(true)

  subscriptions TenantSubscription[]
}

model TenantSubscription {
  id               String             @id @default(cuid())
  tenantId         String             @unique
  planId           String
  status           SubscriptionStatus @default(TRIAL)
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])
}

/// Demo-mode billing history — no real payment gateway exists yet, so every row is `mode: "demo"`
/// and `amount` is informational (prorated math), never actually charged.
model SubscriptionInvoice {
  id               String   @id @default(cuid())
  tenantId         String
  planCode         String
  action           String   // 'CHANGE_PLAN' | 'CANCEL'
  amount           Decimal  @db.Decimal(10, 2)
  previousPlanCode String?
  mode             String   @default("demo")
  createdAt        DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

// ─── Phase 5: SaaS platform admin ──────────────────────────────────

model PlatformAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  auditLogs PlatformAuditLog[]
}

/// Records every platform-admin mutation (suspend/reactivate a tenant, resolve a ticket, ...).
model PlatformAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String   // 'SUSPEND_TENANT' | 'REACTIVATE_TENANT' | 'RESOLVE_TICKET' | ...
  targetType String   // 'TENANT' | 'TICKET'
  targetId   String
  detail     Json?
  createdAt  DateTime @default(now())

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([createdAt])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id        String       @id @default(cuid())
  tenantId  String
  subject   String
  body      String
  status    TicketStatus @default(OPEN)
  priority  String       @default("normal")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

// ─── Purchase orders & stock take (Phase 2) ───────────────────────

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  tenantId   String
  branchId   String
  supplierId String?
  poNumber   String
  status     PurchaseOrderStatus @default(DRAFT)
  notes      String?
  orderedAt  DateTime?
  receivedAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch              @relation(fields: [branchId], references: [id])
  supplier Supplier?           @relation(fields: [supplierId], references: [id])
  lines    PurchaseOrderLine[]

  @@unique([tenantId, poNumber])
  @@index([tenantId, status])
}

model PurchaseOrderLine {
  id           String  @id @default(cuid())
  purchaseOrderId String
  productId    String
  quantity     Decimal @db.Decimal(12, 3)
  receivedQty  Decimal @db.Decimal(12, 3) @default(0)
  unitCost     Decimal @db.Decimal(12, 2) @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
}

enum StockTakeStatus {
  OPEN
  /// Counts done; variance lines await owner approval before stock ADJUSTMENT.
  PENDING_APPROVAL
  COMPLETED
  CANCELLED
}

model StockTake {
  id               String          @id @default(cuid())
  tenantId         String
  branchId         String
  status           StockTakeStatus @default(OPEN)
  notes            String?
  /// Optional filter metadata: { abcGrades, category, cyclePlan }
  filterMeta       Json?
  completedAt      DateTime?
  approvedAt       DateTime?
  approvedByUserId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch          @relation(fields: [branchId], references: [id])
  lines  StockTakeLine[]

  @@index([tenantId, status])
}

model StockTakeLine {
  id             String   @id @default(cuid())
  stockTakeId    String
  productId      String
  systemQty      Decimal  @db.Decimal(12, 3)
  /// Null until counted — forces intentional cycle count (not silent zero-variance).
  countedQty     Decimal? @db.Decimal(12, 3)
  /// Shrink / damage / found / recount / other
  varianceReason String?

  stockTake StockTake @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@index([stockTakeId])
}

/// GSTR-2B import for ITC match against purchase bills.
model Gstr2bImport {
  id        String   @id @default(cuid())
  tenantId  String
  period    String
  source    String   @default("CSV")
  createdAt DateTime @default(now())

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines  Gstr2bLine[]

  @@index([tenantId, period])
}

enum Gstr2bMatchStatus {
  UNMATCHED
  MATCHED
  MISMATCH
  IGNORED
}

model Gstr2bLine {
  id                   String           @id @default(cuid())
  importId             String
  supplierGstin        String?
  supplierName         String?
  invoiceNumber        String
  invoiceDate          DateTime?
  taxableValue         Decimal          @db.Decimal(14, 2) @default(0)
  cgst                 Decimal          @db.Decimal(14, 2) @default(0)
  sgst                 Decimal          @db.Decimal(14, 2) @default(0)
  igst                 Decimal          @db.Decimal(14, 2) @default(0)
  totalAmount          Decimal          @db.Decimal(14, 2) @default(0)
  matchStatus          Gstr2bMatchStatus @default(UNMATCHED)
  matchedPurchaseBillId String?
  notes                String?
  createdAt            DateTime         @default(now())

  import Gstr2bImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@index([invoiceNumber])
  @@index([matchedPurchaseBillId])
}

// ─── AI agent actions (Phase 5) ───────────────────────────────────

enum AiAgentActionStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
}

model AiAgentAction {
  id          String              @id @default(cuid())
  tenantId    String
  type        String
  title       String
  payload     Json
  status      AiAgentActionStatus @default(PENDING)
  resultNote  String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

